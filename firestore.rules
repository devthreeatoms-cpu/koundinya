rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath());
    }

    function userRole() {
      return exists(userPath()) ? userDoc().data.role : 'agency';
    }

    function userAgencyId() {
      return exists(userPath()) ? userDoc().data.agency_id : null;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function agencyData() {
      let aid = userAgencyId();
      return aid != null && exists(/databases/$(database)/documents/agencies/$(aid))
        ? get(/databases/$(database)/documents/agencies/$(aid)).data
        : null;
    }

    function canEditCandidates() {
      let ag = agencyData();
      return ag != null && (
        ag.get('is_internal', false) == true ||
        ag.get('can_edit_candidates', false) == true
      );
    }

    function projectAgencyId(projectId) {
      return projectId != null && exists(/databases/$(database)/documents/projects/$(projectId))
        ? get(/databases/$(database)/documents/projects/$(projectId)).data.agency_id
        : null;
    }

    // ── users ──────────────────────────────────────────────────────────────
    // Users can read their own profile. Admins can read all.
    // Self-updates are allowed but role and agency_id cannot be changed.
    // Only admins can create or delete profiles.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.agency_id == resource.data.agency_id)
        || isAdmin()
      );
      allow create, delete: if isAdmin();
    }

    // ── agencies ───────────────────────────────────────────────────────────
    // All signed-in users can read (needed for name resolution throughout the
    // app). Only admins can write.
    match /agencies/{agencyId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── clients ───────────────────────────────────────────────────────────
    match /clients/{clientId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── project_statuses ───────────────────────────────────────────────────
    match /project_statuses/{statusId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── candidates ─────────────────────────────────────────────────────────
    // Reads are open to all authenticated users (client-side filtering is used).
    // Creates: agency users can only create candidates with their own agency_id.
    // Updates: supply partners need the can_edit_candidates toggle; internal
    //          team members can always update their own candidates.
    // Deletes: admin only (soft-delete is an update, not a delete).
    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin()
          ? request.resource.data.agency_id == null
          : request.resource.data.agency_id == userAgencyId()
      );
      allow update: if isSignedIn() && (
        isAdmin()
          ? resource.data.agency_id == null
          : resource.data.agency_id == userAgencyId() && canEditCandidates()
      );
      allow delete: if isAdmin();
    }

    // ── projects ───────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin()
          ? request.resource.data.agency_id == null
          : request.resource.data.agency_id == userAgencyId()
      );
      allow update: if isSignedIn() && (
        isAdmin()
          ? resource.data.agency_id == null
          : resource.data.agency_id == userAgencyId()
      );
      allow delete: if isAdmin();
    }

    // ── assignments ────────────────────────────────────────────────────────
    // Reads open to all authenticated users (bypass filter used in several hooks).
    // Creates: agency users can only create assignments tagged with their agency_id.
    // Updates: agency users can only update their own agency's assignments.
    // Deletes: admin only.
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() || request.resource.data.agency_id == userAgencyId()
      );
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.agency_id == userAgencyId()
      );
      allow delete: if isAdmin();
    }

    // ── onboarding_candidates ────────────────────────────────────────────────
    // Phase-1 project onboarding records. Readable by authenticated users.
    // Agency users may only create/update records owned by their agency.
    match /onboarding_candidates/{onboardingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.agency_id == userAgencyId() ||
        projectAgencyId(request.resource.data.project_id) == userAgencyId()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.agency_id == userAgencyId() ||
        projectAgencyId(resource.data.project_id) == userAgencyId()
      );
      allow delete: if isAdmin();
    }

    // ── internal_partners (legacy collection) ─────────────────────────────
    match /internal_partners/{partnerId} {
      allow read, write: if isAdmin();
    }

    // ── counters ───────────────────────────────────────────────────────────
    // Only admins need counters (sequential ID generation).
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
